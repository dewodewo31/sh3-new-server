              "raw": "{\n    \"email\": \"budi@example.com\",\n    \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login. Set `token` dari response untuk environment variabel."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
