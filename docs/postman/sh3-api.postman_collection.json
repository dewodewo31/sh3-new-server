{
  "info": {
    "_postman_id": "sh3-api-collection",
    "name": "SH3 Running Club API",
    "description": "Collection API SH3 Running Club (Revision 1).\n\nBase URL: `{{base_url}}/api/v1`\n\nSemua endpoint di dalam folder berautentikasi memakai header `Authorization: Bearer {{token}}` (kecuali Auth publik).",
